# Memex — Environment Variables
# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: host port 5436 (Docker) — see docker-compose.yml
DATABASE_URL=postgresql://memex:memex@localhost:5436/memex

# ── Ollama (local AI — zero cost) ─────────────────────────────────────────────
# Uses native Ollama on port 11434 (no Docker — GPU works out of the box).
# Pull models once: ollama pull llama3.2 && ollama pull nomic-embed-text
# Not needed for a cloud-only install (see README "Path B"): leave these as they are and never start Ollama.
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Optional: local multi-modal capture ───────────────────────────────────────
# Vision (image → text): pull an Ollama vision model, e.g. `ollama pull llava:7b`.
# Voice (audio → text): `pip install openai-whisper` (needs Python + ffmpeg).
# WHISPER_MODEL selects the model size: tiny | base | small | medium | large.
WHISPER_MODEL=base

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002

# REQUIRED. At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# It signs your login AND encrypts API keys saved in Settings (unless KEY_ENCRYPTION_SECRET is set). The Docker image
# (NODE_ENV=production) refuses to start with an example value, a short one or a repetitive one. Outside production the
# server only warns. Changing it later makes saved API keys unreadable (enter them again).
JWT_SECRET=replace-with-a-random-32-char-string

# ── Optional: cloud AI providers (Claude, Gemini, OpenAI, Groq) ──────────────
# Off by default — Memex is local-first and runs entirely on Ollama with no keys.
# A key only makes a provider *available*. It is used only if you also pick it in
# Settings and turn on cloud consent, and never while Strict Local Mode is on.
# Embeddings (search, Ask, related items) can come from Gemini or OpenAI; Claude and Groq have no
# embeddings API. Without Ollama, switch the embedding model in Settings > AI BEFORE saving your first note.
# The embedding model, thresholds and consent are runtime settings (Settings), not variables here.
# Passwords/Personal items and items tagged private/no-cloud always stay on Ollama.
# Keys can also be pasted in Settings > API keys (stored encrypted, never shown again). A key set
# here always takes priority over a saved one. The API never returns a key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# Check this model id is still current before relying on it; override anytime in Settings.
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
# Check this model id is still current before relying on it; OpenAI retires ids regularly. Override anytime in Settings.
OPENAI_MODEL=gpt-5.4-mini
GROQ_API_KEY=
# Groq (OpenAI-compatible, fast open models). Check the id is current; Groq retires models. Override anytime in Settings.
GROQ_MODEL=openai/gpt-oss-120b

# ── Optional: YouTube Data API (video descriptions) ──────────────────────────
# Fetches a video's full description — recipes and links usually live there, not in the transcript.
# Used by Explain / Extract recipe and the video classifier. Free daily quota; off in Strict Local Mode.
# Google Cloud console > enable "YouTube Data API v3" > Credentials > API key.
YOUTUBE_API_KEY=

# ── Optional: secret that encrypts keys saved from Settings ──────────────────
# Defaults to JWT_SECRET. If this secret changes, saved keys can no longer be read and must be re-entered.
# When set it must meet the same rules as JWT_SECRET.
KEY_ENCRYPTION_SECRET=

# ── Docker (`docker compose up -d`) ───────────────────────────────────────────
# Used only by docker-compose.yml, not by `npm run dev`.
#   MEMEX_PORT=3002                  host port for the app
#   OLLAMA_URL_DOCKER=http://host.docker.internal:11434   native Ollama (default); with `--profile ollama` use http://ollama:11434
# The image sets MEMEX_AUTO_MIGRATE=true (migrations apply on boot). Outside Docker migrations are a step you run:
# `npm run db:migrate`. MEMEX_AUTO_MIGRATE=true turns the automatic behaviour on for a source install too.
# MEMEX_ALLOW_WEAK_SECRETS=1 lets a production start go ahead with a weak secret (not recommended).

# ── Optional: notify DevBrain on re-index completion ─────────────────────────
# When set, a bulk reprocess job POSTs its result to DevBrain's public
# /api/notify hook. Leave blank to disable (default).
DEVBRAIN_NOTIFY_URL=http://localhost:3001/api/notify
