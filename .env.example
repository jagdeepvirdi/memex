# Memex — Environment Variables
# Copy to .env and fill in values before running

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: host port 5436 (Docker) — see docker-compose.yml
DATABASE_URL=postgresql://memex:memex@localhost:5436/memex

# ── Ollama (local AI — zero cost) ─────────────────────────────────────────────
# Uses native Ollama on port 11434 (no Docker — GPU works out of the box).
# Pull models once: ollama pull llama3.2 && ollama pull nomic-embed-text
OLLAMA_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBED_MODEL=nomic-embed-text

# ── Optional: local multi-modal capture ───────────────────────────────────────
# Vision (image → text): pull an Ollama vision model, e.g. `ollama pull llava:7b`.
# Voice (audio → text): `pip install openai-whisper` (needs Python + ffmpeg).
# WHISPER_MODEL selects the model size: tiny | base | small | medium | large.
WHISPER_MODEL=base

# ── Server ────────────────────────────────────────────────────────────────────
PORT=3002

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-random-32-char-string

# ── Optional: cloud AI providers (Claude, Gemini) ────────────────────────────
# Off by default — Memex is local-first and runs entirely on Ollama with no keys.
# A key only makes a provider *available*. It is used only if you also pick it in
# Settings and turn on cloud consent, and never while Strict Local Mode is on.
# Passwords/Personal items and items tagged private/no-cloud always stay on Ollama.
# Keys live here only; the API never returns them.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
# Check this model id is still current before relying on it; override anytime in Settings.
GEMINI_MODEL=gemini-2.5-flash

# ── Optional: notify DevBrain on re-index completion ─────────────────────────
# When set, a bulk reprocess job POSTs its result to DevBrain's public
# /api/notify hook. Leave blank to disable (default).
DEVBRAIN_NOTIFY_URL=http://localhost:3001/api/notify
